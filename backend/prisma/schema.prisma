generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// TASK
// ==========================================

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  priority    Int
  date        String
  endDate     String?
  completed   Boolean @default(false)
  projectId   String?
  assignedTo  String?

  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==========================================
// PROJECT
// ==========================================

model Project {
  id          String  @id @default(cuid())
  name        String
  color       String
  theme       String
  customColor String?
  parentId    String?

  // Pole historyczne - zastąpimy je
  // docelowo relacją ProjectMember.
  sharedWith String[]

  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Project[] @relation("ProjectHierarchy")

  tasks Task[]

  members     ProjectMember[]
  invitations ProjectInvitation[]

  @@index([ownerId])
}

// ==========================================
// USER
// ==========================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Ustawienia zaproszeń
  autoAcceptInvites Boolean @default(false)

  // Projekty, których użytkownik jest właścicielem
  projects Project[]

  // Projekty, do których użytkownik dołączył
  memberships ProjectMember[]

  // Zaproszenia wysłane i otrzymane
  sentInvitations     ProjectInvitation[] @relation("SentInvitations")
  receivedInvitations ProjectInvitation[] @relation("ReceivedInvitations")
}

// ==========================================
// PROJECT MEMBER
// ==========================================

enum ProjectMemberRole {
  EDITOR
  VIEWER
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(EDITOR)

  joinedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Jeden użytkownik może należeć do projektu
  // tylko jeden raz.
  @@unique([projectId, userId])
  @@index([userId])
}

// ==========================================
// PROJECT INVITATION
// ==========================================

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model ProjectInvitation {
  id         String @id @default(cuid())
  projectId  String
  senderId   String
  receiverId String

  status ProjectInvitationStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sender User @relation("SentInvitations", fields: [senderId], references: [id])

  receiver User @relation("ReceivedInvitations", fields: [receiverId], references: [id])

  @@index([receiverId, status])
  @@index([projectId, status])
}
